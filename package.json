{
  "name": "wempos-forum",
  "version": "5.97.0",
  "private": false,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "wrangler dev --local --infer-origin-from-routes=false",
    "deploy": "wrangler deploy --keep-vars --var COMMIT_SHA:$(git rev-parse --short HEAD)",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply ${D1_DATABASE:-wempo-forum-data} --remote",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "check": "pnpm run lint && pnpm test",
    "i18n:add": "node scripts/i18n-key.mjs add",
    "i18n:remove": "node scripts/i18n-key.mjs remove"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "core-js-compat": "3.51.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "altcha-lib": "^2.10.0",
    "content-type": "^3.1.1",
    "cookie-es": "^3.1.1",
    "css-tree": "^3.2.1",
    "escape-html": "^1.0.3",
    "file-type": "^22.3.0",
    "fresh": "^0.5.2",
    "image-dimensions": "^2.6.0",
    "ipaddr.js": "^2.5.0",
    "secure-json-parse": "^4.1.1",
    "serialize-error": "^13.1.0",
    "strip-bom": "^5.0.0"
  }
}
