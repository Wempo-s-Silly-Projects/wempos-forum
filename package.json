{
  "name": "wempos-forum",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --var COMMIT_SHA:$(git rev-parse --short HEAD)",
    "db:migrate:local": "wrangler d1 migrations apply wempo-forum-data --local",
    "db:migrate:remote": "wrangler d1 migrations apply wempo-forum-data --remote",
    "test": "node --test",
    "db:migrate:preview": "wrangler d1 migrations apply wempo-forum-preview --env preview --remote"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "fsevents@2.3.3": true
  }
}
