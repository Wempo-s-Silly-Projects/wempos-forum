{
  "name": "wempos-forum",
  "version": "5.83.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --keep-vars --var COMMIT_SHA:$(git rev-parse --short HEAD)",
    "db:migrate:local": "wrangler d1 migrations apply ${D1_DATABASE:-wempo-forum-data} --local",
    "db:migrate:remote": "wrangler d1 migrations apply ${D1_DATABASE:-wempo-forum-data} --remote",
    "test": "node --test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "core-js-builder": "latest",
    "eslint": "latest",
    "fast-check": "latest",
    "globals": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@simplewebauthn/server": "latest",
    "altcha-lib": "latest",
    "content-type": "latest",
    "cookie-es": "latest",
    "css-tree": "latest",
    "escape-html": "latest",
    "file-type": "latest",
    "fresh": "latest",
    "image-dimensions": "latest",
    "ipaddr.js": "latest",
    "secure-json-parse": "latest",
    "serialize-error": "latest",
    "strip-bom": "latest"
  }
}
