{
  "name": "wempos-forum",
  "version": "4.34.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --keep-vars --var COMMIT_SHA:$(git rev-parse --short HEAD)",
    "db:migrate:local": "wrangler d1 migrations apply wempo-forum-data --local",
    "db:migrate:remote": "wrangler d1 migrations apply wempo-forum-data --remote",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
